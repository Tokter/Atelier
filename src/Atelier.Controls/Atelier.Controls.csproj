<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Atelier.Core\Atelier.Core.csproj" />
    <ProjectReference Include="..\Atelier.Layout\Atelier.Layout.csproj" />
    <ProjectReference Include="..\Atelier.Rendering\Atelier.Rendering.csproj" />
    <ProjectReference Include="..\Atelier.Theming\Atelier.Theming.csproj" />
    <!-- Generates MaterialIcons (the icon names as string constants) from MaterialIconKind. -->
    <ProjectReference Include="..\Atelier.Generators\Atelier.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\Assets\Fonts\MaterialSymbolsRounded-VariableFont_FILL,GRAD,opsz,wght.ttf" Link="Assets\Fonts\MaterialSymbolsRounded.ttf" LogicalName="MaterialSymbolsRounded.ttf" />
    <EmbeddedResource Include="..\..\Assets\Icons\Atelier.png" Link="Assets\Icons\Atelier.png" LogicalName="Atelier.png" />
  </ItemGroup>

</Project>
