<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Controls for audio tools: the Knob, and (to come) timelines, rulers and waveform views that share one zoom and
    scroll position. It brings its own renderers and adds them to Material themes, and its own markup methods.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Atelier.Core\Atelier.Core.csproj" />
    <ProjectReference Include="..\Atelier.Controls\Atelier.Controls.csproj" />
    <ProjectReference Include="..\Atelier.Theming.Material\Atelier.Theming.Material.csproj" />
    <ProjectReference Include="..\Atelier.Markup\Atelier.Markup.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Atelier.Audio</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Like Atelier.Markup: keep every public member documented and every cref valid. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1572;CS1573;CS1574;CS1591</WarningsAsErrors>
  </PropertyGroup>

</Project>
