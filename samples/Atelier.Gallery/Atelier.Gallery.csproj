<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Atelier.Core\Atelier.Core.csproj" />
    <ProjectReference Include="..\..\src\Atelier.Layout\Atelier.Layout.csproj" />
    <ProjectReference Include="..\..\src\Atelier.Rendering\Atelier.Rendering.csproj" />
    <ProjectReference Include="..\..\src\Atelier.Theming\Atelier.Theming.csproj" />
    <ProjectReference Include="..\..\src\Atelier.Theming.Material\Atelier.Theming.Material.csproj" />
    <ProjectReference Include="..\..\src\Atelier.Controls\Atelier.Controls.csproj" />
    <ProjectReference Include="..\..\src\Atelier.Platform.Silk\Atelier.Platform.Silk.csproj" />
    <ProjectReference Include="..\..\src\Atelier.Markup\Atelier.Markup.csproj" />
    <ProjectReference Include="..\..\src\Atelier.Generators\Atelier.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.152.1" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Pages\" />
    <EmbeddedResource Include="Assets\**\*" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Release Single-File Standalone Executable Configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!-- Clean up any remaining third-party native symbols so only the single .exe remains -->
  <Target Name="RemovePublishPdbs" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_PublishPdbs Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishPdbs)" />
  </Target>

</Project>
